
'''
1. 对线性模型和sigmoid代价计算的函数更新
2. 优化了绘图步骤
3. 增加等高线视图中的梯度下降路径
'''
import numpy as np
import matplotlib.pyplot as plt

x_train = np.array([0., 1, 2, 3, 4, 5], dtype=np.float64)
y_train = np.array([0., 0, 0, 1, 1, 1], dtype=np.float64)

m = x_train.shape[0]

def sigmoid(z):
    return 1 / (1 + np.exp(-z))

def compute_mse_grid(W, B):
    z = x_train[:, None, None] * W[None, :, :] + B[None, :, :]
    y3 = y_train[:, None, None]
    return (1 / (2 * m)) * np.sum((z - y3) ** 2, axis=0)

def compute_logistic_grid(W, B):
    z = x_train[:, None, None] * W[None, :, :] + B[None, :, :]
    p = np.clip(sigmoid(z), 1e-12, 1 - 1e-12)
    y3 = y_train[:, None, None]
    return (1 / m) * np.sum(-(y3 * np.log(p) + (1 - y3) * np.log(1 - p)), axis=0)
# ================= 梯度下降轨迹计算 =================
def gradient_descent_mse(w_init, b_init, lr, n_iters):
    #将损失函数的计算封装进梯度下降路线中
    w, b = w_init, b_init
    path = [(w, b)]
    losses = []
    for _ in range(n_iters):
        # 计算当前损失
        err = w * x_train + b - y_train
        loss = (1 / (2 * m)) * np.sum(err ** 2)
        losses.append(loss)
        
        # 计算梯度
        dw = (1 / m) * np.sum(err * x_train)
        db = (1 / m) * np.sum(err)
        
        # 更新参数
        w -= lr * dw
        b -= lr * db
        path.append((w, b))
    return np.array(path), np.array(losses)

def gradient_descent_logistic(w_init, b_init, lr, n_iters):
    w, b = w_init, b_init
    path = [(w, b)]
    losses = []
    for _ in range(n_iters):
        # 计算当前损失
        p = sigmoid(w * x_train + b)
        p_clip = np.clip(p, 1e-12, 1 - 1e-12)
        loss = (1 / m) * np.sum(-(y_train * np.log(p_clip) + (1 - y_train) * np.log(1 - p_clip)))
        losses.append(loss)
        
        # 计算梯度
        dw = (1 / m) * np.sum((p - y_train) * x_train)
        db = (1 / m) * np.sum(p - y_train)
        
        # 更新参数
        w -= lr * dw
        b -= lr * db
        path.append((w, b))
    return np.array(path), np.array(losses)

w_range = np.linspace(-100, 400, 200) 
b_range = np.linspace(-100, 100, 200)
W, B = np.meshgrid(w_range, b_range)

print(W.shape)
print(w_range.shape)
J_MSE = compute_mse_grid(W, B)
J_Logistic = compute_logistic_grid(W, B)

# 执行梯度下降 (起点设为 w=0, b=0)
path_mse, losses_mse = gradient_descent_mse(w_init=0, b_init=0, lr=0.01, n_iters=500)
path_log, losses_log = gradient_descent_logistic(w_init=0, b_init=0, lr=0.5, n_iters=500)


# ================= 1. 3D 曲面图 =================
fig1, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 6), subplot_kw={'projection': '3d'})
surf1 = ax1.plot_surface(W, B, J_MSE, cmap='viridis', edgecolor='none', alpha=0.8)
ax1.set_title('MSE Loss Surface')
ax1.set_xlabel('w'); ax1.set_ylabel('b'); ax1.set_zlabel('J(w, b)')
fig1.colorbar(surf1, ax=ax1, shrink=0.5, aspect=8, pad=0.1)

surf2 = ax2.plot_surface(W, B, J_Logistic, cmap='plasma', edgecolor='none', alpha=0.8)
ax2.set_title('Logistic Loss Surface')
ax2.set_xlabel('w'); ax2.set_ylabel('b'); ax2.set_zlabel('J(w, b)')
fig1.colorbar(surf2, ax=ax2, shrink=0.5, aspect=8, pad=0.1)
fig1.tight_layout()


# ================= 2. 等高线图 + 梯度下降路线 =================
fig2, (ax3, ax4) = plt.subplots(1, 2, figsize=(14, 6))

# MSE 等高线
contour3 = ax3.contour(W, B, J_MSE, levels=30, cmap='viridis')
ax3.contourf(W, B, J_MSE, levels=30, cmap='viridis', alpha=0.6)
ax3.clabel(contour3, inline=True, fontsize=8) 
# 画路线
ax3.plot(path_mse[:, 0], path_mse[:, 1], 'r.-', markersize=2, linewidth=1, label='Gradient Descent')
ax3.plot(path_mse[0, 0], path_mse[0, 1], 'ko', markersize=8, label='Start')
ax3.plot(path_mse[-1, 0], path_mse[-1, 1], 'r*', markersize=12, label='End')
ax3.set_title('MSE Contour + GD Path')
ax3.set_xlabel('w'); ax3.set_ylabel('b')
ax3.legend()

# Logistic 等高线
contour4 = ax4.contour(W, B, J_Logistic, levels=30, cmap='plasma')
ax4.contourf(W, B, J_Logistic, levels=30, cmap='plasma', alpha=0.6)
ax4.clabel(contour4, inline=True, fontsize=8) 
# 画路线
ax4.plot(path_log[:, 0], path_log[:, 1], 'r.-', markersize=2, linewidth=1, label='Gradient Descent')
ax4.plot(path_log[0, 0], path_log[0, 1], 'ko', markersize=8, label='Start')
ax4.plot(path_log[-1, 0], path_log[-1, 1], 'r*', markersize=12, label='End')
ax4.set_title('Logistic Contour + GD Path')
ax4.set_xlabel('w'); ax4.set_ylabel('b')
ax4.legend()

fig2.tight_layout()


# ================= 3. 损失随迭代下降的曲线 =================
fig3, (ax5, ax6) = plt.subplots(1, 2, figsize=(14, 4))
ax5.plot(losses_mse, 'b-', linewidth=2)
ax5.set_title('MSE Loss vs Iterations')
ax5.set_xlabel('Iterations'); ax5.set_ylabel('Loss')
ax5.grid(alpha=0.3)

ax6.plot(losses_log, 'm-', linewidth=2)
ax6.set_title('Logistic Loss vs Iterations')
ax6.set_xlabel('Iterations'); ax6.set_ylabel('Loss')
ax6.grid(alpha=0.3)

plt.tight_layout()
plt.show()